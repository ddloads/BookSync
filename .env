# BookSync Environment Variables
# Used by docker-compose.yml for container deployment

# User and Group ID (1000 is default for most Linux users)
PUID=1000
PGID=1000

# Timezone (Central Time)
TZ=America/Chicago

# Directory where BookSync will store its database and settings
BOOKSYNC_DATA_DIR=/config/booksync

# Port for the Companion API (Mobile App)
PORT=3005

# Host path for your audiobook library (Update this to your actual server path)
# Example: /mnt/user/audiobooks or /share/audiobooks
DOWNLOADS_PATH=/path/to/your/audiobooks

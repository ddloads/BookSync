{
  "name": "booksync",
  "version": "1.0.1",
  "description": "Audible to Audiobookshelf Sync",
  "main": "./out/main/index.js",
  "author": "ddsplayground",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts && vite build --config vite.server.config.ts",
    "build:python": "python -m venv src/main/python/venv && .\\src\\main\\python\\venv\\Scripts\\pip install audible==0.8.2 audible-cli==0.3.2 httpx==0.23.3 pyinstaller && .\\src\\main\\python\\venv\\Scripts\\pyinstaller --onefile --distpath resources src/main/python/audible_wrapper.py",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "start:web": "node dist-web/server/index.cjs",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "package": "npm run build:python && npm run build && electron-builder",
    "version:patch": "npm version patch && git add CHANGELOG.md && git commit --amend --no-edit",
    "version:minor": "npm version minor && git add CHANGELOG.md && git commit --amend --no-edit",
    "version:major": "npm version major && git add CHANGELOG.md && git commit --amend --no-edit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.ddsplayground.booksync",
    "productName": "BookSync",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "Logo.png"
    ],
    "extraResources": [
      {
        "from": "resources/audible_wrapper.exe",
        "to": "audible_wrapper.exe"
      }
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "axios": "^1.8.1",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.479.0",
    "music-metadata": "^11.12.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.11",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^4.1.5"
  }
}

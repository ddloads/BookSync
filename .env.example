# Host port for the BookSync web app.
BOOKSYNC_PORT=3015

# Persistent BookSync database/settings directory on the Docker host.
BOOKSYNC_CONFIG_PATH=./config

# Audiobook library path on the Docker host.
# BookSync writes to /downloads inside the container, and Docker maps that to this path.
# Default Portainer VM Docker volume path:
# BOOKSYNC_DOWNLOADS_PATH=/var/lib/docker/volumes/Audiobooks/_data
# Alternative Linux mount example:
# BOOKSYNC_DOWNLOADS_PATH=/mnt/audiobooks
BOOKSYNC_DOWNLOADS_PATH=/var/lib/docker/volumes/Audiobooks/_data

# Container timezone.
TZ=America/Chicago
